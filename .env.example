# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── SAP S/4HANA OData (self-service / self_service_api.py only) ─
SAP_USERNAME=your_sap_user
SAP_PASSWORD=your_sap_password
SAP_S4_BASE_URL=https://your-sap-api-url
SAP_CLIENT=100
SAP_USERNAME_FORMAT=user
SAP_ODATA_PREFIX=/odata

# ─── SAP Monitoring (failed-idocs / background-jobs) ─────
# Same integration as Backend_Bainocular_FastAPI/ticket_src/ams_classification.py
# NOT the same as SAP_S4_BASE_URL above.

# Failed IDOCs — prefer CPI (same iFlow as background jobs). APIM often 404 off-VPN.
SAP_FAILED_IDOCS_FETCH_MODE=cpi
SAP_FAILED_IDOCS_ODATA_BASE_URL=http://sapbtpai.com:8000/sap/opu/odata/sap/ZC_IDOC_FAILED_CDS
SAP_FAILED_IDOCS_ENTITY=ZC_IDOC_FAILED
# Optional APIM (retrigger + apim mode): SAP_MONITORING_APIM_BASE=...
# SAP_FAILED_IDOCS_URL=...   # optional full APIM URL override
# SAP_MONITORING_APIM_V4_BASE=...  # optional; bulk retrigger (defaults from APIM base)

# Background jobs via CPI iFlow (POST JSON body → OData proxy)
SAP_BACKGROUND_JOBS_CPI_URL=https://e1b04be9trial.it-cpitrial05-rt.cfapps.us10-001.hana.ondemand.com/http/s4odata
SAP_BACKGROUND_JOBS_CPI_USER=your-cpi-oauth-client
SAP_BACKGROUND_JOBS_CPI_PASSWORD=your-cpi-oauth-secret
SAP_BACKGROUND_JOBS_ODATA_BASE_URL=http://sapbtpai.com:8000/sap/opu/odata/sap/ZSB_JOB_MONITOR

# Optional — only if this machine cannot reach SAP directly (calls another Bainocular host):
# SAP_MONITORING_PROXY_BASE=https://api-dev.bainocular.seleccionconsulting.com

# ─── Optional ─────────────────────────────────────────────
# PORT=8000
# FERNET_KEY=...
# DATABASE_URL=sqlite:///./sapautonomous.db
